            android:exported="false"
            android:theme="@style/Theme.Eggyhub.FullScreen" />

        <activity
            android:name="com.eggyhub.android.FilePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Eggyhub.FullScreen" />
            
        <activity
