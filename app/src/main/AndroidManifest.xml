            android:authorities="com.eggyhub.android.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name="com.eggyhub.android.CreateArticleActivity"
            android:exported="false" />
        <activity
            android:name="com.eggyhub.android.AboutActivity"
            android:exported="false" />
        <activity
            android:name="com.eggyhub.android.UserAgreementActivity"
            android:exported="false" />
        <activity
