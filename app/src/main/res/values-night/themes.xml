<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Eggyhub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryVariant">@android:color/transparent</item>
        <item name="colorOnPrimary">@color/blue_eggyhub_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="statTextColor">@color/blue_eggyhub_dark</item>
        <item name="android:colorForeground">@color/gray</item>
        <item name="android:colorBackground">@color/dark_gray</item>
        <!-- Customize your theme here. -->
        <item name="android:textColorSecondary">@color/light_gray</item>
    </style>

    <style name="CardBackgroundTheme">
        <item name="android:background">@color/blue_eggyhub_dark</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CardView.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>



    <style name="Theme.Eggyhub.FullScreen" parent="Theme.Eggyhub">
        <item name="android:windowFullscreen">true</item>e
        <item name="android:windowContentOverlay">@null</item>
        <item name="taskCardBackgroundColor">@color/blue_eggyhub_dark</item>
    </style>
</resources>