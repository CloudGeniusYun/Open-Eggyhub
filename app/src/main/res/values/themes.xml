<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Eggyhub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryVariant">@android:color/transparent</item>
        <item name="colorOnPrimary">@color/blue_eggyhub</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Customize your theme here. -->
        <item name="taskCardBackgroundColor">@color/blue_eggyhub</item>
        <item name="statTextColor">@color/blue_eggyhub</item>
        <item name="android:colorForeground">@color/light_gray</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <item name="android:colorBackground">@android:color/white</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CardView.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Full screen theme for image preview -->
    <style name="Theme.Eggyhub.FullScreen" parent="Theme.Eggyhub">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:actionBarStyle">@style/FullScreenActionBarStyle</item>
    </style>

    <style name="FullScreenActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:displayOptions">none</item>
    </style>

    <style name="CardBackgroundTheme">
        <item name="android:background">@color/color_card_background_half_blue</item>
    </style>

    <style name="Theme.Eggyhub.TransparentActivity" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Slider 标签样式：浅蓝色背景，白色文字 -->
    <style name="SliderLabelStyle" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">#0096FF</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>