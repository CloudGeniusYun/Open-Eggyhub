<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/imageViewShareCode"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewShareCodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分享码名称"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/textViewShareCodeDescription"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="分享码描述分享码描述分享码描述分享码描述分享码描述分享码描述"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textViewShareCodeStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="库存: 99"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:background="#66FFFFFF"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/imageViewPriceIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/suipian" />

            <TextView
                android:id="@+id/textViewPriceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>