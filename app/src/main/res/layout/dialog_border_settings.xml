<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="边框设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="边框宽度"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/seekBarBorderWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="2" />

    <TextView
        android:id="@+id/tvBorderWidth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2dp"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="边框颜色"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnColorBlack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#000000"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorWhite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FFFFFF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorGray"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#888888"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorRed"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FF0000"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorBlue"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#0000FF"
            android:layout_margin="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnColorGreen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#00FF00"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorYellow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FFFF00"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorOrange"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#FF8800"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorPurple"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#8800FF"
            android:layout_margin="4dp" />

        <Button
            android:id="@+id/btnColorTransparent"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#00000000"
            android:layout_margin="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前颜色："
            android:textSize="14sp" />

        <View
            android:id="@+id/viewCurrentColor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="#000000" />

    </LinearLayout>

</LinearLayout>