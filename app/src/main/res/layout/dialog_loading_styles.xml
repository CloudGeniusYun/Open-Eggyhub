<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="M2 加载样式预览"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 样式 1: 系统默认 ProgressBar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="1. 系统默认 ProgressBar"
                android:textColor="@color/gray" />

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" />

            <!-- 样式 2: Material 默认 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. Material 默认 (紫/主题色)"
                android:textColor="@color/gray" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true" />

            <!-- 样式 3: 品牌蓝色 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="3. 品牌蓝色 (EggyBlue)"
                android:textColor="@color/gray" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/blue_eggyhub" />

            <!-- 样式 4: 加粗圆环 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="4. 加粗圆环 (4dp)"
                android:textColor="@color/gray" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/blue_eggyhub"
                app:trackThickness="4dp" />

            <!-- 样式 5: 大尺寸细圆环 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="5. 大尺寸细圆环 (64dp)"
                android:textColor="@color/gray" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/blue_eggyhub"
                app:indicatorSize="64dp"
                app:trackThickness="2dp" />

            <!-- 样式 6: 圆角末端 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="6. 圆角末端 (Rounded)"
                android:textColor="@color/gray" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                app:indicatorColor="@color/blue_eggyhub"
                app:trackCornerRadius="8dp"
                app:trackThickness="4dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_close_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_join_now"
        android:text="关闭预览"
        android:textColor="@android:color/white" />

</LinearLayout>