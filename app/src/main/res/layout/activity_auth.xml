<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="安全授权验证"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="检测到当前运行环境存在异常（调试/Root/签名不符），请输入授权码以继续使用。"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="您的设备ID (请发送给管理员):"
        android:textColor="#888888"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/deviceIdTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textSize="16sp"
            android:textColor="#000000"
            android:textIsSelectable="true"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/copyButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="复制"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue_eggyhub"/>
    </LinearLayout>

    <EditText
        android:id="@+id/authCodeEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="在此输入授权码"
        android:layout_marginTop="30dp"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:minLines="3"
        android:gravity="top|start"
        android:inputType="textMultiLine"/>

    <Button
        android:id="@+id/verifyButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="验 证 授 权"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/blue_eggyhub"/>

</LinearLayout>