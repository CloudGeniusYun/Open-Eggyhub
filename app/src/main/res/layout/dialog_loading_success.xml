<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <com.eggyhub.android.StatusLoadingView
        android:id="@+id/status_loading_view"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_loading_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在处理..."
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/layout_share_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/rounded_corners_background_small"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_share_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2ydnmf52cka6f"
            android:textColor="@color/gray"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_copy_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="复制"
            android:textColor="@color/blue_eggyhub"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp" />
    </LinearLayout>

</LinearLayout>